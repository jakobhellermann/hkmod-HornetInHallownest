<Project Sdk="Microsoft.NET.Sdk">
    <Import Condition="Exists('../HollowKnightPath.props')" Project="../HollowKnightPath.props"/>
    <Import Project="../HollowKnight.TargetFrameworks.props"/>

    <PropertyGroup>
        <!-- One assembly per game version, see HollowKnight.TargetFrameworks.props -->
        <TargetFrameworks>hk1512620;hk1578</TargetFrameworks>
        <AssemblyTitle>HornetInHallownest</AssemblyTitle>
        <Version>0.4.0</Version>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>recommended</AnalysisMode>

        <RestorePackagesWithLockFile>True</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true'">True</RestoreLockedMode>

        <!-- Game path, default steam location. Override in HollowKnightPath.props -->
        <GamePath Condition="'$(GamePath)' == '' And '$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Hollow Knight</GamePath>
        <GamePath Condition="'$(GamePath)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Hollow Knight</GamePath>
        <GamePath Condition="'$(GamePath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Hollow Knight</GamePath>
        <SilksongGamePath Condition="'$(SilksongGamePath)' == ''">$([MSBuild]::NormalizePath('$(GamePath)', '..', 'Hollow Knight Silksong'))</SilksongGamePath>

        <!-- Managed directories -->
        <SilksongManaged Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(SilksongGamePath)/Hollow Knight Silksong.app/Contents/Resources/Data/Managed</SilksongManaged>
        <SilksongManaged Condition="'$(SilksongManaged)' == ''">$(SilksongGamePath)/Hollow Knight Silksong_Data/Managed</SilksongManaged>

        <!-- Assembly references: Use full local-refs when present, otherwise fall back to committed stubs for CI -->
        <CiRefs>$(MSBuildProjectDirectory)/../ci-refs</CiRefs>
        <LocalRefs>$(MSBuildProjectDirectory)/../local-refs</LocalRefs>
        <AssetsDir>$(MSBuildProjectDirectory)/../Assets</AssetsDir>
        <!-- Overridden per game version in HollowKnight.TargetFrameworks.props -->
        <BundleDir Condition="'$(BundleDir)' == ''">$(AssetsDir)/bundles</BundleDir>
        <SilksongManaged Condition="!Exists('$(SilksongManaged)')">$(PkgSilksong_GameLibs)/ref/netstandard2.1</SilksongManaged>
        <RefsDir Condition="'$(RefsDir)' == '' And Exists('$(LocalRefs)/Silksong.Assembly-CSharp.dll')">$(LocalRefs)</RefsDir>
        <RefsDir Condition="'$(RefsDir)' == ''">$(CiRefs)/lib</RefsDir>

        <!-- Shortens and anonymizes paths in debug symbols relative to the project directory. Breakpoints will not work, however. -->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.26.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Silksong.Assembly-CSharp" Private="true" Aliases="Silksong">
            <HintPath>$(RefsDir)/Silksong.Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.Assembly-CSharp-firstpass" Private="true" Aliases="Silksong">
            <HintPath>$(RefsDir)/Silksong.Assembly-CSharp-firstpass.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.PlayMaker" Private="true" Aliases="SilksongPM">
            <HintPath>$(RefsDir)/Silksong.PlayMaker.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.TeamCherry.Localization" Private="true" Aliases="SilksongLoc">
            <HintPath>$(RefsDir)/Silksong.TeamCherry.Localization.dll</HintPath>
        </Reference>
    </ItemGroup>


    <ItemGroup>
        <!-- File source for the silksong assemblies referenced below. ExcludeAssets=compile to prevent duplicates -->
        <PackageReference
                Include="Silksong.GameLibs"
                Version="[1.2.0-silksong1.0.30000]"
                PrivateAssets="all"
                ExcludeAssets="compile"
                GeneratePathProperty="true"
        />
    </ItemGroup>

    <PropertyGroup Condition="Exists('$(ManagedDir)')">
        <ExcludeAssetsIfLocalReference>compile</ExcludeAssetsIfLocalReference>
    </PropertyGroup>
    <Target Name="ValidateManagedDir" BeforeTargets="BeforeBuild">
        <Error Condition="'$(ManagedDir)' != '' And !Exists('$(ManagedDir)')" Text="ManagedDir '$(ManagedDir)' does not exist."/>
    </Target>
    <ItemGroup Condition="Exists('$(ManagedDir)')">
        <LocalReferences Include="Assembly-CSharp;PlayMaker;Mono.Cecil;MonoMod.RuntimeDetour;MonoMod.Utils;Newtonsoft.Json"/>
        <!-- Only shipped from 1.5.12620 on; 1.5.78 compiles tk2d into Assembly-CSharp. -->
        <LocalReferences Include="TeamCherry.Localization;TeamCherry.NestedFadeGroup;TeamCherry.SharedUtils;TeamCherry.TK2D;System.ValueTuple" Condition="'$(TargetFramework)' == 'hk1512620'"/>
        <LocalReferences Include="UnityEngine;UnityEngine.AnimationModule;UnityEngine.AssetBundleModule;UnityEngine.AudioModule;UnityEngine.CoreModule;UnityEngine.InputLegacyModule;UnityEngine.Physics2DModule;UnityEngine.ParticleSystemModule"/>
        <Reference Include="@(LocalReferences->'$(ManagedDir)/%(Identity).dll')" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Referenced directly from the silksong Managed dir, so that dotnet build works without relying on mod setup -->
        <Reference Include="Newtonsoft.Json.UnityConverters" Private="false">
            <HintPath>$(SilksongManaged)/Newtonsoft.Json.UnityConverters.dll</HintPath>
        </Reference>
        <Reference Include="Unity.Addressables" Private="false">
            <HintPath>$(SilksongManaged)/Unity.Addressables.dll</HintPath>
        </Reference>
        <Reference Include="Unity.ResourceManager" Private="false">
            <HintPath>$(SilksongManaged)/Unity.ResourceManager.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Generate full local-refs/Silksong.*.dll from the Silksong install for local referencing -->
    <Target Name="GenerateLocalRefs">
        <Error Condition="!Exists('$(SilksongManaged)')" Text="Silksong not found at $(SilksongManaged)"/>
        <ItemGroup>
            <PrefixInput Include="Assembly-CSharp;Assembly-CSharp-firstpass;PlayMaker;ConditionalExpression;TeamCherry.NestedFadeGroup;TeamCherry.Localization;TeamCherry.SharedUtils"/>
            <StaleRef Include="$(LocalRefs)/*.dll"/>
        </ItemGroup>
        <Delete Files="@(StaleRef)"/>
        <Exec Command="dotnet run -c Release --project &quot;$(MSBuildProjectDirectory)/../tools/SilksongPrefixer&quot; -- Silksong &quot;$(LocalRefs)&quot; --managed &quot;$(SilksongManaged)&quot; @(PrefixInput->'&quot;$(SilksongManaged)/%(Identity).dll&quot;', ' ')"/>
    </Target>

    <!-- HK 1.5.78: Build UnityCompat shim into mod's managed/ folder, which is installed in SilksongSetup -->
    <Target Name="BuildUnityCompat" BeforeTargets="BeforeBuild" Condition="'$(TargetFramework)' == 'hk1578'">
        <Error Condition="!Exists('$(ManagedDir)')" Text="The UnityCompat shim is compiled against HK 1.5.78's Managed folder; set ManagedDir."/>
        <PropertyGroup>
            <UnityCompatProperties>Configuration=$(Configuration);HKRefs=$(ManagedDir)</UnityCompatProperties>
        </PropertyGroup>
        <MSBuild Projects="../tools/UnityCompat/UnityCompat.csproj" Targets="Restore" Properties="$(UnityCompatProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" RemoveProperties="TargetFramework"/>
        <MSBuild Projects="../tools/UnityCompat/UnityCompat.csproj" Targets="Build" Properties="$(UnityCompatProperties)" RemoveProperties="TargetFramework">
            <Output TaskParameter="TargetOutputs" ItemName="ManagedInstallFile"/>
        </MSBuild>
        <ItemGroup>
            <ManagedInstallFile Include="@(ManagedInstallFile->'%(RootDir)%(Directory)AssetsTools.NET.dll')"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyMod" AfterTargets="PostBuildEvent" Condition="'$(ModsDir)' != '' And Exists('$(ModsDir)')">
        <PropertyGroup>
            <CopyDir>$(ModsDir)/HornetInHallownest</CopyDir>
        </PropertyGroup>
        <Message Importance="high" Text="copying $(TargetPath) to $(CopyDir) ..."/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(BundleDir)/monoscripts.silksong.bundle" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(BundleDir)/silksong-resources.bundle" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="@(ManagedInstallFile)" DestinationFolder="$(CopyDir)/managed" SkipUnchangedFiles="true"/>
    </Target>

    <!-- Allowlist files for `dotnet publish` -->
    <Target Name="CurateModPublish" AfterTargets="Publish">
        <ItemGroup>
            <PublishJunk Include="$(PublishDir)**/*"/>
        </ItemGroup>
        <Delete Files="@(PublishJunk)"/>
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PublishDir)"/>
        <Copy SourceFiles="$(BundleDir)/monoscripts.silksong.bundle;$(BundleDir)/silksong-resources.bundle" DestinationFolder="$(PublishDir)"/>
        <Copy SourceFiles="@(ManagedInstallFile)" DestinationFolder="$(PublishDir)/managed"/>

        <!-- create zip for distribution -->
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(MSBuildProjectDirectory)/bin/$(Configuration)/HornetInHallownest.zip" Overwrite="true"/>
    </Target>
</Project>
