<Project Sdk="Microsoft.NET.Sdk">
    <Import Condition="Exists('LocalConfig.props')" Project="LocalConfig.props"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyTitle>HornetInHallownest</AssemblyTitle>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>recommended</AnalysisMode>

        <!-- Game path, default steam location. Override in LocalConfig.props -->
        <GamePath Condition="'$(GamePath)' == '' And '$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Hollow Knight</GamePath>
        <GamePath Condition="'$(GamePath)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Hollow Knight</GamePath>
        <GamePath Condition="'$(GamePath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Hollow Knight</GamePath>
        <SilksongGamePath Condition="'$(SilksongGamePath)' == ''">$([MSBuild]::NormalizePath('$(GamePath)', '..', 'Hollow Knight Silksong'))</SilksongGamePath>

        <!-- Managed directories -->
        <HollowKnightManaged Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(GamePath)/hollow_knight.app/Contents/Resources/Data/Managed</HollowKnightManaged>
        <HollowKnightManaged Condition="'$(HollowKnightManaged)' == ''">$(GamePath)/hollow_knight_Data/Managed</HollowKnightManaged>
        <SilksongManaged Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(SilksongGamePath)/Hollow Knight Silksong.app/Contents/Resources/Data/Managed</SilksongManaged>
        <SilksongManaged Condition="'$(SilksongManaged)' == ''">$(SilksongGamePath)/Hollow Knight Silksong_Data/Managed</SilksongManaged>

        <CopyDir Condition="'$(CopyDir)' == ''">$(HollowKnightManaged)/Mods/HornetInHallownest</CopyDir>

        <!-- Shortens and anonymizes paths in debug symbols relative to the project directory. Breakpoints will not work, however. -->
        <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.26.0" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Silksong.AssemblyCSharp" Private="true" Aliases="Silksong">
            <HintPath>lib/Silksong.AssemblyCSharp.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.AssemblyCSharpfirstpass" Private="true" Aliases="Silksong">
            <HintPath>lib/Silksong.AssemblyCSharpfirstpass.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.PlayMaker" Private="true" Aliases="SilksongPM">
            <HintPath>lib/Silksong.PlayMaker.dll</HintPath>
        </Reference>
        <Reference Include="Silksong.TeamCherryLocalization" Private="true" Aliases="SilksongLoc">
            <HintPath>lib/Silksong.TeamCherryLocalization.dll</HintPath>
        </Reference>
    </ItemGroup>


    <ItemGroup>
    	<!-- HK / Modding API -->
        <Reference Include="Assembly-CSharp" Private="false">
            <HintPath>$(HollowKnightManaged)/Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Mono.Cecil" Private="false">
            <HintPath>$(HollowKnightManaged)/Mono.Cecil.dll</HintPath>
        </Reference>
        <Reference Include="MonoMod.RuntimeDetour" Private="false">
            <HintPath>$(HollowKnightManaged)/MonoMod.RuntimeDetour.dll</HintPath>
        </Reference>
        <Reference Include="MonoMod.Utils" Private="false">
            <HintPath>$(HollowKnightManaged)/MonoMod.Utils.dll</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json" Private="false">
            <HintPath>$(HollowKnightManaged)/Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="PlayMaker" Private="false">
            <HintPath>$(HollowKnightManaged)/PlayMaker.dll</HintPath>
        </Reference>
        <Reference Include="TeamCherry.Localization" Private="false">
            <HintPath>$(HollowKnightManaged)/TeamCherry.Localization.dll</HintPath>
        </Reference>
        <Reference Include="TeamCherry.NestedFadeGroup" Private="false">
            <HintPath>$(HollowKnightManaged)/TeamCherry.NestedFadeGroup.dll</HintPath>
        </Reference>
        <Reference Include="TeamCherry.SharedUtils" Private="false">
            <HintPath>$(HollowKnightManaged)/TeamCherry.SharedUtils.dll</HintPath>
        </Reference>
        <Reference Include="TeamCherry.TK2D" Private="false">
            <HintPath>$(HollowKnightManaged)/TeamCherry.TK2D.dll</HintPath>
        </Reference>

        <!-- Unity Modules -->
        <Reference Include="UnityEngine" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AnimationModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.AnimationModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.AssetBundleModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.AudioModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.AudioModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule" Private="false">
            <HintPath>$(HollowKnightManaged)/UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>

        <!-- Referenced directly from the silksong Managed dir, so that dotnet build works without relying on mod setup -->
        <Reference Include="Newtonsoft.Json.UnityConverters" Private="false">
            <HintPath>$(SilksongManaged)/Newtonsoft.Json.UnityConverters.dll</HintPath>
        </Reference>
        <Reference Include="Unity.Addressables" Private="false">
            <HintPath>$(SilksongManaged)/Unity.Addressables.dll</HintPath>
        </Reference>
        <Reference Include="Unity.ResourceManager" Private="false">
            <HintPath>$(SilksongManaged)/Unity.ResourceManager.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Generate lib/Silksong.*.dll from the Silksong install -->
    <Target Name="SetupSilksongLibs">
        <Error Condition="!Exists('$(SilksongManaged)')" Text="Silksong not found at $(SilksongManaged)"/>
        <ItemGroup>
            <PrefixInput Include="Assembly-CSharp;Assembly-CSharp-firstpass;PlayMaker;ConditionalExpression;TeamCherry.NestedFadeGroup;TeamCherry.Localization;TeamCherry.SharedUtils"/>
            <StaleLib Include="$(MSBuildProjectDirectory)/lib/*.dll"/>
        </ItemGroup>
        <Delete Files="@(StaleLib)"/>
        <Exec Command="dotnet run -c Release --project &quot;$(MSBuildProjectDirectory)/../tools/SilksongPrefixer&quot; -- Silksong &quot;$(MSBuildProjectDirectory)/lib&quot; --managed &quot;$(SilksongManaged)&quot; @(PrefixInput->'&quot;$(SilksongManaged)/%(Identity).dll&quot;', ' ')"/>
    </Target>

    <Target Name="CopyMod" AfterTargets="PostBuildEvent" Condition="'$(CopyDir)' != ''">
        <Message Importance="high" Text="copying $(TargetPath) to $(CopyDir) ..."/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)/lib/monoscripts.silksong.bundle" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)/lib/silksong-resources.bundle" DestinationFolder="$(CopyDir)" SkipUnchangedFiles="true"/>
        <ItemGroup>
            <B2Lib Include="$(MSBuildProjectDirectory)/lib/*.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(B2Lib)" DestinationFiles="@(B2Lib->'$(CopyDir)/%(Filename)%(Extension).managed')" SkipUnchangedFiles="true"/>
    </Target>

    <!-- Allowlist files for `dotnet publish` -->
    <Target Name="CurateModPublish" AfterTargets="Publish">
        <ItemGroup>
            <PublishJunk Include="$(PublishDir)**/*"/>
            <ModLib Include="$(MSBuildProjectDirectory)/lib/*.dll"/>
        </ItemGroup>
        <Delete Files="@(PublishJunk)"/>
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PublishDir)"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)/lib/monoscripts.silksong.bundle;$(MSBuildProjectDirectory)/lib/silksong-resources.bundle" DestinationFolder="$(PublishDir)"/>
        <Copy SourceFiles="@(ModLib)" DestinationFiles="@(ModLib->'$(PublishDir)%(Filename)%(Extension).managed')"/>

        <!-- create zip for distribution -->
        <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(MSBuildProjectDirectory)/bin/$(Configuration)/HornetInHallownest.zip" Overwrite="true"/>
    </Target>
</Project>
