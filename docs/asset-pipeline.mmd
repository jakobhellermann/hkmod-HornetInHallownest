flowchart TB
    subgraph Build["Build time"]
        B1["Silksong install (1.0.30000)"] -->|"make ci-refs"| B2["Silksong.* prefixed stubs (+ hk1578)"]
        B2 --> B3["mod zip: mod + unity-scene-repacker"]
        B2s["UnityCompat -> managed/"] --> B3
    end
    subgraph First["In game, first start"]
        F1["copy Silksong-only DLLs into Managed"] --> F2["prefix Silksong assemblies -> Managed/Silksong.*"]
        F1s["copy UnityCompat into Managed"] --> F2
        F2 --> F3["downgrade ScriptingAssemblies to Unity 2020.2"]
        F3 --> F4["register Silksong.* in ScriptingAssemblies.json -> restart HK"]
    end
    subgraph Run["In game"]
        R1["build and cache monoscripts.silksong.bundle + silksong-resources.bundle from Silksong"]
        R1 --> R2["mount the user's Silksong aa catalog directly"]
        R2 --> R3["monoscripts.silksong.bundle replaces Silksong's *_monoscripts.bundle"]
        R2 --> R4["stream original bundles with compatibility patches"]
        R1 --> R5["Resources.Load served from silksong-resources.bundle"]
        R6["replace Unity 6 shaders with HK / generic ones"]
    end
    B3 -->|"unzip into Managed/Mods"| First
    First --> Run
    L["dashed: HK 1.5.78 only"]

    class B2s,F1s,F3,R4,R6,L hk1578
    classDef hk1578 stroke-dasharray: 5 5

